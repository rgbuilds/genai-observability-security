{
  "schema_version": "pattern_library.v1",
  "library_id": "pattern_library",
  "library_version": "1",
  "payload_fields": [
    "content.system",
    "content.user",
    "content.output",
    "content.retrieved",
    "content.tool_args",
    "content.tool_result",
    "authz.principal_id",
    "authz.roles",
    "authz.resource"
  ],
  "canary_grammar": {
    "pattern": "SYNTH-[A-Z0-9]{2,12}-[0-9A-F]{8}",
    "match": "substring",
    "case_sensitive": true,
    "match_class": "canary_grammar",
    "detector_id": "patternlib.v1.canary_grammar",
    "category": "sensitive_data",
    "replacement": "[REDACTED:canary_grammar]"
  },
  "secret_keys": {
    "names": ["token", "password", "secret", "api_key"],
    "normalize": ["lowercase", "hyphen_to_underscore"],
    "match": "exact_or_underscore_suffix",
    "match_class": "secret_key",
    "detector_id": "patternlib.v1.secret_key",
    "category": "sensitive_data",
    "replacement": "[REDACTED:secret_key]"
  },
  "precedence": ["secret_key_value", "canary_substring"],
  "pii_rules": [],
  "propagation_detector": "reserved"
}
